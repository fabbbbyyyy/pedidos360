# =====================================================================
# ÚNICO archivo .env del proyecto. Copiá este archivo a ".env" y
# completá los valores. NO se versiona (ver .gitignore).
# =====================================================================

# --- Credenciales AWS (cuenta educativa / AWS Academy Learner Lab) ---
# Se usan SOLO para que la CLI de Serverless Framework se autentique
# contra AWS al momento de desplegar (npm run deploy). NO se inyectan
# como variables de entorno dentro de los Lambdas: AWS_REGION,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY y AWS_SESSION_TOKEN son
# nombres reservados por AWS Lambda y no se pueden usar dentro de
# "provider.environment" en serverless.yml.
#
# IMPORTANTE: en Learner Lab estas 3 credenciales son TEMPORALES y
# expiran cada pocas horas. Cuando eso pase, volvé a copiarlas desde
# el panel de AWS Academy ("AWS Details" > "AWS CLI") y actualizá este
# archivo antes de volver a desplegar.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1
S3_BUCKET=pedidos360-product-images-dev-REPLACE_WITH_UNIQUE_SUFFIX
# Dominio adicional permitido. Si queda vacío, solo se permite localhost.
ALLOWED_ORIGIN=

# ARN del rol de ejecución que usarán TODAS las Lambdas de este
# proyecto (se referencia en serverless.yml como provider.iam.role).
# En AWS Academy / Learner Lab normalmente NO se pueden crear roles
# nuevos, así que reutilizamos el que ya viene creado: "LabRole".
# Reemplazá 123456789012 por tu AWS_ACCOUNT_ID real.
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/LabRole

# --- Azure Entra ID (autenticación, validada por API Gateway) ---
# Tenant ID de tu directorio de Azure AD / Entra ID.
AZURE_TENANT_ID=

# Audience que API Gateway va a exigir en el claim "aud" del JWT.
# Corresponde al "Application ID URI" que configuraste al exponer tu
# API en el App Registration de Azure ("Expose an API"). Normalmente
# tiene la forma: api://<client-id-de-la-app-registrada>, solo se 
# pega el client ID de la app registrada.
# Ejemplo: api://12345678901234567890123456789012
AZURE_API_AUDIENCE=<client-id-de-la-app-registrada>
