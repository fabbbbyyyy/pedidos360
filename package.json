{
  "name": "pedidos360-backend",
  "version": "1.0.0",
  "description": "Backend serverless de Pedidos360 (orders + catalog) sobre AWS Lambda, API Gateway HTTP API y DynamoDB, con autenticación vía Azure Entra ID",
  "main": "serverless.yml",
  "scripts": {
    "deploy": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove --stage dev",
    "offline": "serverless offline start --noAuth",
    "logs:orders": "serverless logs -f createOrder -t",
    "test": "jest"
  },
  "devDependencies": {
    "serverless": "^3.39.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.52.1",
    "serverless-offline": "^13.6.0",
    "jest": "^29.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  }
}
